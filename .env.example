# Copy to .env and fill in. .env is gitignored.
# Settings with a default are commented out and show that default. Uncomment one to change it.

# Required: the NVR's address and login.
NVR_URL=http://192.168.1.64
NVR_USER=admin
NVR_PASSWORD=

# RTSP port used for live video. Only change this if you changed it on the NVR.
# NVR_RTSP_PORT=554

# Set to true if NVR_URL is https and the NVR uses its default self-signed certificate.
# NVR_ALLOW_SELF_SIGNED=false

# The app has no login of its own, so keep it on localhost unless your network is trusted.
# HOST=127.0.0.1
# PORT=3000

# Folder for remembered NVR answers. The app must be able to write to it.
# CACHE_DIR=cache

# How long to remember NVR answers about past dates, in hours. 0 turns that cache off.
# CACHE_YEARS_HOURS=24
# CACHE_MONTHS_HOURS=24
# CACHE_DAYS_HOURS=24
# CACHE_RECORDINGS_HOURS=24

# How long to remember answers about the current year, month and day, which are still
# gaining video, in minutes. 0 turns that cache off.
# CACHE_TODAY_MINUTES=5
